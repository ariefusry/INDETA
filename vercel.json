{
    "version": 2,
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.9.0"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/site\\.webmanifest",
            "dest": "/public/site.webmanifest",
            "headers": {
                "Content-Type": "application/manifest+json"
            }
        },
        {
            "src": "/sw\\.js",
            "dest": "/public/sw.js",
            "headers": {
                "Content-Type": "application/javascript",
                "Service-Worker-Allowed": "/"
            }
        },
        {
            "src": "/(css|js|images|build|favicon.ico|robots.txt)/(.*)",
            "dest": "/public/$1/$2"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
