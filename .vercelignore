# Abaikan folder dependensi
/vendor
/node_modules

# Abaikan file environment lokal
.env
.env.*

# Abaikan folder Git dan log
.git
/storage/*.log

# PENTING: Abaikan entry point asli Laravel 
/public/index.php

# Abaikan cache package lokal
/bootstrap/cache/*.php

# Abaikan file HOT (Penyebab error Vite di production)
/public/hot

# Paksa upload folder build Vite
!/public/build

# Abaikan cache internal Laravel
/storage/framework/views/*.php
/storage/framework/cache/*.php
/storage/framework/cache/data/**/*
